generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspaces  Workspace[]
  memberships Membership[]
}

model Workspace {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  isDefault      Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   Application[]
  opportunities  JobOpportunity[]
  resumes        ResumeVersion[]
  interviews     InterviewSession[]
  tasks          Task[]
  aiActions      AiAction[]
  aiMemories     AiMemory[]
  auditLogs      AuditLog[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String
  avatarUrl   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  tasks       Task[]       @relation("AssignedTasks")
  auditLogs   AuditLog[]
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Company {
  id            String           @id @default(uuid())
  name          String           @unique
  domain        String?
  scamRisk      String           @default("LOW")
  riskNotes     String?
  trustScore    Float            @default(90.0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  applications  Application[]
  opportunities JobOpportunity[]
}

model Application {
  id              String             @id @default(uuid())
  workspaceId     String
  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company            @relation(fields: [companyId], references: [id])
  role            String
  status          String             @default("APPLIED")
  platform        String             @default("Direct Email")
  appliedDate     DateTime           @default(now())
  oaLink          String?
  interviewDate   DateTime?
  recruiterName   String?
  recruiterEmail  String?
  salaryRange     String?
  location        String?
  notes           String?
  resumeVersionId String?
  resumeVersion   ResumeVersion?     @relation(fields: [resumeVersionId], references: [id])
  matchScore      Float              @default(85.0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  timeline        TimelineEvent[]
  interviews      InterviewSession[]
  aiActions       AiAction[]
}

model TimelineEvent {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  date          DateTime    @default(now())
  eventType     String
  source        String      @default("Gmail AI")
}

model JobOpportunity {
  id              String   @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  role            String
  platform        String   @default("LinkedIn")
  jobUrl          String?
  location        String?  @default("Remote")
  salaryRange     String?
  skillMatch      Float    @default(88.0)
  experienceMatch Float    @default(85.0)
  locationMatch   Float    @default(100.0)
  salaryMatch     Float    @default(80.0)
  overallScore    Float    @default(88.0)
  scamRisk        String   @default("LOW")
  description     String?
  missingSkills   String?
  matchedSkills   String?
  createdAt       DateTime @default(now())
}

model ResumeVersion {
  id            String        @id @default(uuid())
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title         String
  targetRole    String
  fileUrl       String?
  rawText       String
  atsScore      Float         @default(85.0)
  keySkills     String
  missingSkills String?
  bulletPoints  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]
}

model InterviewSession {
  id             String          @id @default(uuid())
  workspaceId    String
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  companyName    String
  role           String
  stage          String          @default("Technical")
  scheduledAt    DateTime
  interviewer    String?
  prepSheet      String?
  status         String          @default("SCHEDULED")
  createdAt      DateTime        @default(now())
  mockInterviews MockInterview[]
}

model MockInterview {
  id                 String            @id @default(uuid())
  interviewSessionId String?
  interviewSession   InterviewSession? @relation(fields: [interviewSessionId], references: [id], onDelete: SetNull)
  stage              String            @default("Technical")
  questions          String
  userAnswers        String?
  technicalScore     Float             @default(80.0)
  communicationScore Float             @default(80.0)
  structureScore     Float             @default(80.0)
  confidenceScore    Float             @default(80.0)
  specificityScore   Float             @default(80.0)
  overallScore       Float             @default(80.0)
  improvementPlan    String?
  createdAt          DateTime          @default(now())
}

model Task {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])
  title          String
  description    String?
  priority       String    @default("MEDIUM")
  status         String    @default("TODO")
  dueDate        DateTime?
  timeBlockStart DateTime?
  timeBlockEnd   DateTime?
  category       String    @default("General")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AiAction {
  id            String       @id @default(uuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title         String
  description   String
  confidence    Float
  reason        String
  evidence      String
  actionType    String
  payload       String
  riskLevel     String       @default("LOW")
  status        String       @default("PENDING")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model AiMemory {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    String
  key         String
  value       String
  confidence  Float    @default(95.0)
  source      String   @default("User Input")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, category, key])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  entityType  String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())
}
