# ─────────────────────────────────────────────────────────────────────────────
# DayNight Pilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (Phase 1+). For dev you can use SQLite via prisma/schema.prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/daynightpilot?schema=public"
# SQLite dev override (optional, for local dev without Postgres):
# DATABASE_URL="file:./dev.db"

# ── Authentication (NextAuth.js v5) ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_USE_openssl_rand_hex_32

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URI to: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Envelope Encryption ───────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# REQUIRED in production — app will refuse to start without this
ENCRYPTION_MASTER_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# ── AI Providers ──────────────────────────────────────────────────────────────
# Gemini (primary) — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
# OpenAI (fallback) — https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key

# ── Notion Integration ────────────────────────────────────────────────────────
NOTION_API_KEY=your_notion_integration_secret
NOTION_DATABASE_ID=your_notion_database_id

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── Gmail OAuth (Python integration) ──────────────────────────────────────────
# Set automatically from credentials.json and token.json
# For GitHub Actions, paste the full JSON as secrets
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=

# ── Redis (Phase 1 distributed rate limiting + Phase 2 job queues) ────────────
# Upstash Redis URL (free tier at https://upstash.com)
REDIS_URL=redis://localhost:6379
# Or: REDIS_URL=rediss://default:PASSWORD@HOST:PORT

# ── App Settings ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
GMAIL_MAX_RESULTS=50
POLL_INTERVAL_HOURS=3
LOG_LEVEL=INFO

# ── Billing (Phase 4) ─────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
